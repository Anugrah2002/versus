# ==============================================================================
# Versus Backend Environment Variables Template
# Copy this file to .env for local development
# In GitHub Actions CI/CD, configure these in Repository Settings -> Secrets and variables -> Actions
# ==============================================================================

# --- AI PROVIDERS ---
# Primary: Cloudflare Workers AI (https://dash.cloudflare.com/)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast

# Secondary: Groq Free API (https://console.groq.com/keys) - 14,400 req/day
GROQ_API_KEY=gsk_your_groq_api_key_here

# Tertiary: Google Gemini API (https://aistudio.google.com/app/apikey) - 1,500 req/day
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# --- FIREBASE FIRESTORE ---
# Option A: Path to service account JSON file (for local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Raw JSON string or Base64 encoded service account (for GitHub Actions Secrets)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Firestore Configuration
FIRESTORE_PROJECT_ID=versus-news
FIRESTORE_COLLECTION_ARTICLES=articles
FIRESTORE_COLLECTION_SYSTEM=_system

# --- PIPELINE TUNING & LIMITS ---
MAX_FEEDS_CONCURRENT=30
PER_DOMAIN_MAX_CONCURRENT=2
PER_DOMAIN_MIN_DELAY_MS=200
SCRAPE_TIMEOUT_SECONDS=10
MIN_ARTICLE_WORD_COUNT=120
SIMILARITY_DISTANCE_THRESHOLD=0.38
DATA_RETENTION_DAYS=30
ENABLE_LOCAL_FALLBACK=true
DRY_RUN=false
